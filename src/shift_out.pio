; PIO program for fast shift register output to 74HC595
; Outputs 3 data lines (SIN_1, SIN_2, SIN_3) with clock
;
; Pin mapping (consecutive pins):
;   Base + 0: SIN_1
;   Base + 1: SIN_2
;   Base + 2: SIN_3
;   Base + 3: CLOCK
;
; Data format: 32-bit word containing:
;   bits [0:15]   - SIN_2 data (16 bits)
;   bits [16:31]  - SIN_3 data (16 bits)
;   SIN_1 is generated based on bit position (row select)
;
; autopull is enabled, threshold 32

.program shift_out
.side_set 1 opt

.wrap_target
    ; Pull data from FIFO (autopull enabled)
    ; Each 32-bit word contains SIN_2[15:0] and SIN_3[15:0]

    set x, 15           ; Loop counter for 16 bits

bitloop:
    out pins, 3 side 0  ; Output 3 data bits, clock low
    jmp x-- bitloop side 1 ; Clock high, decrement counter

.wrap

; Alternative version with explicit row select
.program shift_out_with_row
.side_set 1

.wrap_target
public entry_point:
    pull block              ; Wait for data from FIFO
    mov y, osr              ; Save data to Y
    set x, 15               ; Loop counter for 16 bits

bitloop:
    ; Output format: [SIN_3][SIN_2][SIN_1]
    ; Bit 0 = SIN_1 (row select)
    ; Bit 1 = SIN_2 (panel data)
    ; Bit 2 = SIN_3 (panel data)
    mov osr, y              ; Restore data
    out pins, 3 side 0      ; Output 3 bits, clock low
    jmp x-- bitloop side 1  ; Clock high, decrement and loop

.wrap

% c-sdk {
static inline void shift_out_program_init(PIO pio, uint sm, uint offset, uint pin_base) {
    pio_sm_config c = shift_out_program_get_default_config(offset);

    // Set up output pins: SIN_1, SIN_2, SIN_3 (3 consecutive pins)
    sm_config_set_out_pins(&c, pin_base, 3);

    // Set up sideset pin: CLOCK (pin_base + 3)
    sm_config_set_sideset_pins(&c, pin_base + 3);

    // Configure pins as outputs
    pio_gpio_init(pio, pin_base);     // SIN_1
    pio_gpio_init(pio, pin_base + 1); // SIN_2
    pio_gpio_init(pio, pin_base + 2); // SIN_3
    pio_gpio_init(pio, pin_base + 3); // CLOCK

    pio_sm_set_consecutive_pindirs(pio, sm, pin_base, 4, true);

    // Shift out to the right, autopull enabled, threshold 32
    sm_config_set_out_shift(&c, true, true, 32);

    // Set clock divider for desired shift speed
    // 125MHz / 1 = 125MHz max
    sm_config_set_clkdiv(&c, 1.0f);

    // Initialize and start the state machine
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
